# Variables públicas de la app (se incrustan en el bundle: NO son secretas).
# Copiar a .env y ajustar. El archivo .env está ignorado por Git.

# URL base del backend Spring Boot (sin /api/v1). Vacío mientras se use el backend simulado.
EXPO_PUBLIC_API_URL=
# 1 = backend simulado (Fase 1). 0 = backend real (Fase 4).
EXPO_PUBLIC_USE_MOCK_API=1
# dev | piloto  (piloto exige la misma versión de app en los tres celulares, RN-17)
EXPO_PUBLIC_APP_ENV=dev
