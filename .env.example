# Variables públicas de la app (se incrustan en el bundle: NO son secretas). Copiar a .env y ajustar.
# El archivo .env está ignorado por Git. La app NO tiene claves de Cloudinary ni de Supabase: solo habla con Django.

# URL base de la plataforma Django (sin /api/v1).
#   Piloto:  https://monitoreo.agricolariachuelo.org
#   Laptop:  http://<IP-de-la-laptop>:8000   (python manage.py runserver 0.0.0.0:8000)
#   Vacío:   backend simulado (demostración sin servidor)
EXPO_PUBLIC_API_URL=
# 1 = backend simulado (demostración, Expo Go). 0 = plataforma Django real (EXPO_PUBLIC_API_URL obligatoria).
EXPO_PUBLIC_USE_MOCK_API=1
# dev | piloto  (piloto exige la misma versión de app en los tres celulares, RN-17)
EXPO_PUBLIC_APP_ENV=dev
